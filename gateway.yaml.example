#   - id: openhands-docker
#     type: openhands
#     container_name: openhands-dev        # 通过容器名发现
#     capabilities: [read, write, execute]
#
#   - id: astrbot-docker
#     type: astrbot
#     compose_project: astrbot             # Docker Compose 项目名
#     compose_service: bot                 # 服务名
#     capabilities: [read]
#
#   - id: custom-agent
#     type: generic
#     container_id: abc123def456           # 容器 ID（备用）
#     port: 8080                           # 容器内 HTTP 端口（可选）
#     capabilities: [read]