# nexus-gateway 配置模板
# 复制此文件为 gateway.yaml 并填入真实密钥

# ── 基础配置 ──
port: 8646
host: 127.0.0.1
gateway_key: "${GATEWAY_KEY}"  # 替换为你的网关密钥

# ── Provider 配置 ──
providers:
  example-provider:
    api: "https://api.example.com/v1"
    api_key: "${PROVIDER_API_KEY}"  # 通过环境变量引用
    max_rps: 10

# ── 资源池 ──
pools:
  example_pool:
    description: "示例池"
    providers:
      - name: "example-provider"
        weight: 1
        models:
          - "example-model"
        capabilities:
          - chat
          - code
          - image

# ── 路由策略（v3.11 可插拔模型路由） ──
# mode:
#   formula — 默认，确定性权重轮询（静态权重 × 动态因子 × 质量因子 × 用户因子）
#   model   — 调用外部路由模型服务做决策；失败时按 fallback 处理
#   hybrid  — 优先模型路由，失败自动降级 formula
# ── 前置检查层路径规则（v3.13）──
# 由复杂度+确定度规则表决定路径，不由模型决定
routing_rules:
  trivial:
    action: direct_return
    message: "您好，请问有什么可以帮您？"
  simple_high_confidence:
    pool: pool_a
    validation: none
  simple_low_confidence:
    pool: pool_b
    validation: light
  simple:
    pool: pool_a
    validation: none
  medium:
    pool: pool_b
    supervisor: true
  complex:
    pool: pool_c
    supervisor: true
  very_complex:
    pool: pool_c
    supervisor: true
