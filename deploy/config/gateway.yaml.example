# nexus-gateway — 部署配置示例
# 复制为 .env 并填入真实密钥:
#   cp deploy/config/gateway.yaml.example deploy/config/gateway.yaml
#   cp .env.example .env
#
# 密钥不硬编码, 统一通过环境变量 ${VAR} 引用

gateway_key: ${GATEWAY_KEY}
host: 0.0.0.0
port: 8646

# ── 前置检查层路径规则（v3.13）──
# 由复杂度+确定度规则表决定路径，不由模型决定
routing_rules:
  trivial:
    action: direct_return
    message: "您好，请问有什么可以帮您？"
  simple_high_confidence:
    pool: pool_a
    validation: none
  simple_low_confidence:
    pool: pool_b
    validation: light
  simple:
    pool: pool_a
    validation: none
  medium:
    pool: pool_b
    supervisor: true
  complex:
    pool: pool_c
    supervisor: true
  very_complex:
    pool: pool_c
    supervisor: true

pools:
  pool_a:
    description: 日常对话池
    providers:
      - name: scnet-tp
        weight: 5
        models: [DeepSeek-V4-Flash, GLM-5.2]
        capabilities: [chat, code]
      - name: xiaomi
        weight: 2
        models: [mimo-v2.5-pro]
        capabilities: [chat]
  pool_b:
    description: 增强/需审批池 (QFG New)
    fallback: pool_c
    providers:
      - name: qfg-new
        weight: 3
        models:
          - grok-4.3
          - gpt-5.4
          - grok-imagine-image-2.0
          - grok-imagine-image
          - grok-imagine-image-quality
          - gpt-image-1
          - gpt-image-1.5
          - gpt-image-2
          - gemini-3.1-flash-image
          - grok-imagine-video
          - grok-imagine-video-1.5-preview
        capabilities: [chat, code, image]
  pool_c:
    description: 快速验证池
    providers:
      - name: deepseek-direct
        weight: 1
        models: [deepseek-v4]
        capabilities: [chat]

providers:
  deepseek-direct:
    api: https://api.deepseek.com/v1
    api_key: ${DEEPSEEK_API_KEY}
    max_rps: 50
  qfg-new:
    api: https://qfgapi.com/v1
    api_key: ${QFG_NEW_KEY}
    max_rps: 30
  scnet-tp:
    api: https://api.scnet.cn/api/llm/v1
    api_key: ${SCNET_TP_KEY}
    max_rps: 100
  xiaomi:
    api: https://api.xiaomi.com/v1
    api_key: ${XIAOMI_KEY}
    max_rps: 100
